{
  "name": "secure-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Hardhat + Python secure contract pipeline",
  "scripts": {
    "preflight": "./pipeline.sh preflight",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "check": "./pipeline.sh check",
    "deploy:local": "hardhat ignition deploy ./ignition/modules/SecureVault.js",
    "clean": "hardhat clean && rm -rf coverage coverage.json"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "hardhat": "^2.28.6",
    "solidity-coverage": "^0.8.17"
  },
  "engines": {
    "node": ">=18"
  }
}
