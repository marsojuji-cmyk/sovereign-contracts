{
  "name": "sovereign-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Hardhat + Python secure contract pipeline",
  "scripts": {
    "preflight": "./pipeline.sh preflight",
    "compile": "hardhat build",
    "test": "hardhat test",
    "coverage": "hardhat test --coverage",
    "check": "./pipeline.sh check",
    "check:full": "make check-full",
    "env-check": "./scripts/gates/check_env.sh",
    "slither": "./scripts/analysis/run_slither.sh",
    "deploy:local": "hardhat ignition deploy ./ignition/modules/SecureVault.js",
    "clean": "hardhat clean && rm -rf coverage coverage.json reports",
    "tree": "make tree"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^3.1.1",
    "chai": "^6.3.0",
    "ethers": "^6.14.0",
    "hardhat": "^3.18.1",
    "mocha": "^12.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module"
}
