# Optional network ops only. Local hardhat/localhost need none of these.
# Copy:  cp .env.example .env && chmod 600 .env
# Never commit .env. Never use a mainnet-funded key here.
# Docs: docs/ops/NETWORK_OPS.md
# Offline check: ./scripts/gates/check_env.sh

# Sepolia JSON-RPC (HTTPS). If unset, Hardhat omits the sepolia network.
# SEPOLIA_RPC_URL=https://ethereum-sepolia.example/v1/YOUR_PATH

# Burner deployer key — 0x + 64 hex. Testnet-only ETH. Not a cold wallet.
# DEPLOYER_PRIVATE_KEY=0xYOUR_BURNER_PRIVATE_KEY

# Explorer API for hardhat-verify (optional)
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
